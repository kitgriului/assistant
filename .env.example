# ===============================================
# GuardBot Environment Configuration
# ===============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ===============================================

# -----------------------------------------------
# REQUIRED: Telegram Bot Configuration
# -----------------------------------------------
# Get your bot token from @BotFather on Telegram
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# -----------------------------------------------
# Environment Settings
# -----------------------------------------------
# Options: development, production, testing
ENVIRONMENT=development

# Enable debug mode (verbose logging, detailed errors)
DEBUG=true

# -----------------------------------------------
# Database Configuration
# -----------------------------------------------
# SQLAlchemy database URL
# SQLite (default): sqlite+aiosqlite:///./guardbot.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/guardbot
DB_URL=sqlite+aiosqlite:///./guardbot.db

# Echo SQL queries to console (useful for debugging)
DB_ECHO=false

# Database connection pool settings
DB_POOL_SIZE=5
DB_POOL_RECYCLE=3600

# -----------------------------------------------
# Logging Configuration
# -----------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
# LOG_FILE=logs/guardbot.log

# Enable log file rotation
LOG_ROTATION=true

# Maximum log file size in bytes (10MB)
LOG_MAX_BYTES=10485760

# Number of rotated log files to keep
LOG_BACKUP_COUNT=5

# -----------------------------------------------
# Feature Settings
# -----------------------------------------------
# Maximum photo upload size in MB (1-50)
MAX_PHOTO_SIZE_MB=10

# Default pass validity in days (1-365)
PASS_VALIDITY_DAYS=7

# QR code expiry time in hours (1-720)
QR_CODE_EXPIRY_HOURS=24

# -----------------------------------------------
# Security Settings
# -----------------------------------------------
# Maximum requests per minute per user
RATE_LIMIT_PER_MINUTE=30

# CORS allowed origins (comma-separated, use * for all)
ALLOWED_ORIGINS=*

# -----------------------------------------------
# Directory Paths
# -----------------------------------------------
# All paths are relative to project root
MEDIA_DIR=data/media
EXPORT_DIR=data/export
TEMP_DIR=data/temp

# ===============================================
# Development Tips:
# ===============================================
# 1. Set DEBUG=true for detailed error messages
# 2. Use LOG_LEVEL=DEBUG to see all operations
# 3. Enable DB_ECHO=true to debug SQL queries
# 4. Create LOG_FILE to save logs to file
#
# Production Tips:
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=false
# 3. Use LOG_LEVEL=INFO or WARNING
# 4. Never expose BOT_TOKEN in logs/code
# 5. Use strong database password for PostgreSQL
# ===============================================
