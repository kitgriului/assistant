@router.callback_query(F.data == "patrol_stats")
async def show_patrol_stats(callback: types.CallbackQuery, state: FSMContext):
    """Показать статистику обхода или общую статистику"""
    telegram_id = callback.from_user.id
    has_access, user = await check_user_access(telegram_id, [Role.GUARD.value, Role.ADMIN.value])
    
    if not has_access:
        await callback.answer("❌ Нет прав", show_alert=True)
        return
    
    data = await state.get_data()
    patrol_event_id = data.get('patrol_event_id')
    
    async with get_session() as session:
        # Если есть текущий обход - показываем его статистику
        if patrol_event_id:
            result = await session.execute(
                select(PatrolEvent)
                .options(
                    selectinload(PatrolEvent.checkpoints).selectinload(PatrolCheckpoint.photos)
                )
                .where(PatrolEvent.id == patrol_event_id)
            )
            patrol = result.scalar_one_or_none()
            
            if patrol:
                # Статистика текущего обхода
                total_checkpoints = len(patrol.checkpoints)
                total_photos = sum(len(cp.photos) for cp in patrol.checkpoints)
                checkpoints_with_location = sum(1 for cp in patrol.checkpoints if cp.latitude is not None)
                
                duration = datetime.datetime.utcnow() - patrol.started_at
                hours, remainder = divmod(int(duration.total_seconds()), 3600)
                minutes, seconds = divmod(remainder, 60)
                
                text = (
                    f"📊 <b>Статистика текущего обхода</b>\n\n"
                    f"⏱ Длительность: {hours}ч {minutes}м {seconds}с\n"
                    f"📍 Точек обхода: {total_checkpoints}\n"
                    f"📸 Всего фотографий: {total_photos}\n"
                    f"🗺 С геолокацией: {checkpoints_with_location}\n\n"
                )
                
                # Детали по точкам
                if total_checkpoints > 0:
                    text += "Детали по точкам:\n"
                    for cp in patrol.checkpoints:
                        photos = len(cp.photos)
                        loc = "�" if cp.latitude else "⬜️"
                        note = "📝" if cp.notes else ""
                        text += f"  • Точка №{cp.checkpoint_number}: {photos} фото {loc} {note}\n"
                
                keyboard = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="◀️ Назад", callback_data="patrol_back_to_menu")]
                ])
                
                await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")
                await callback.answer()
                return
        
        # Если нет текущего обхода - показываем общую статистику
        # Считаем завершённые обходы (новая система)
        completed_result = await session.execute(
            select(func.count(PatrolEvent.id))
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'completed'
            )
        )
        completed_patrols = completed_result.scalar_one()
        
        # Считаем данные из завершённых обходов
        patrols_result = await session.execute(
            select(PatrolEvent)
            .options(selectinload(PatrolEvent.checkpoints).selectinload(PatrolCheckpoint.photos))
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'completed'
            )
        )
        all_patrols = patrols_result.scalars().all()
        
        total_checkpoints = sum(len(p.checkpoints) for p in all_patrols)
        total_photos = sum(sum(len(cp.photos) for cp in p.checkpoints) for p in all_patrols)
        total_with_location = sum(sum(1 for cp in p.checkpoints if cp.has_location) for p in all_patrols)
        
        # Считаем старые записи из legacy таблицы Patrol
        from database.models import Patrol
        legacy_result = await session.execute(
            select(func.count(Patrol.id))
        )
        legacy_count = legacy_result.scalar_one()
        
        text = (
            f"📊 <b>Общая статистика обходов</b>\n\n"
            f"✅ Завершённых обходов: {completed_patrols}\n"
            f"📍 Всего точек: {total_checkpoints}\n"
            f"📸 Фотографий: {total_photos}\n"
            f"🗺 С геолокацией: {total_with_location}\n\n"
        )
        
        if legacy_count > 0:
            text += f"📦 Старых записей (legacy): {legacy_count}\n\n"
        
        if completed_patrols == 0:
            text += "У вас пока нет завершённых обходов.\n"
            text += "Начните новый обход!"
        
        keyboard = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="📂 Архив обходов", callback_data="patrol_archive")],
            [InlineKeyboardButton(text="◀️ Назад", callback_data="menu_patrol_management")]
        ])
        
        await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")
        await callback.answer()


