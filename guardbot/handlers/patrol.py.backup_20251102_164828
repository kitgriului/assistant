@router.message(PatrolStates.waiting_photo, F.photo)
async def handle_photo(message: types.Message, state: FSMContext):
    """Обработать полученное фото"""
    data = await state.get_data()
    current_checkpoint_id = data.get('current_checkpoint_id')
    
    if not current_checkpoint_id:
        await message.answer("❌ Ошибка: точка обхода не найдена")
        return
    
    # Сохраняем фото - используем объект PhotoSize
    photo = message.photo[-1]  # Берем самое большое фото
    
    try:
        file_path = await save_file(message.bot, photo, "patrol")
    except Exception as e:
        logger.error(f"Error saving photo: {e}")
        await message.answer("❌ Ошибка при сохранении фото")
        return
    
    # Добавляем фото в БД
    async with get_session() as session:
        new_photo = CheckpointPhoto(
            checkpoint_id=current_checkpoint_id,
            photo_path=file_path,
            uploaded_at=datetime.datetime.utcnow()
        )
        session.add(new_photo)
        await session.commit()
    
    # Обновляем счетчик фото
    photos_count = data.get('checkpoint_photos_count', 0) + 1
    await state.update_data(checkpoint_photos_count=photos_count)
    
    await message.answer(
        f"✅ Фото добавлено! (Всего: {photos_count})\n\n"
        f"Можете добавить ещё фото или вернуться в меню обхода.",
        parse_mode="HTML"
    )


