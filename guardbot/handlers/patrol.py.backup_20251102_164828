PATROLS_PER_PAGE = 10


@router.callback_query(F.data == "patrol_archive")
async def show_patrol_archive(callback: types.CallbackQuery, state: FSMContext, page: int = 1):
    """Показать архив завершённых обходов с пагинацией"""
    telegram_id = callback.from_user.id
    has_access, user = await check_user_access(telegram_id, [Role.GUARD.value, Role.ADMIN.value])
    
    if not has_access:
        await callback.answer("❌ Нет прав", show_alert=True)
        return
    
    async with get_session() as session:
        # Подсчитываем общее количество завершённых обходов
        count_result = await session.execute(
            select(func.count(PatrolEvent.id))
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'completed'
            )
        )
        total_patrols = count_result.scalar_one()
        
        if total_patrols == 0:
            keyboard = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="◀️ Назад", callback_data="menu_patrol_management")]
            ])
            await callback.message.edit_text(
                "📂 <b>Архив завершённых обходов</b>\n\n"
                "У вас пока нет завершённых обходов.",
                reply_markup=keyboard,
                parse_mode="HTML"
            )
            await callback.answer()
            return
        
        # Рассчитываем пагинацию
        total_pages = (total_patrols + PATROLS_PER_PAGE - 1) // PATROLS_PER_PAGE
        page = max(1, min(page, total_pages))
        offset = (page - 1) * PATROLS_PER_PAGE
        
        # Получаем обходы для текущей страницы
        result = await session.execute(
            select(PatrolEvent)
            .options(
                selectinload(PatrolEvent.checkpoints).selectinload(PatrolCheckpoint.photos)
            )
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'completed'
            )
            .order_by(PatrolEvent.completed_at.desc())
            .limit(PATROLS_PER_PAGE)
            .offset(offset)
        )
        patrols = result.scalars().all()
        
        # Формируем текст
        text = f"📂 <b>Архив завершённых обходов</b>\n\n"
        text += f"Страница {page} из {total_pages}\n\n"
        
        for patrol in patrols:
            started = patrol.started_at.strftime('%d.%m.%Y %H:%M')
            completed = patrol.completed_at.strftime('%d.%m.%Y %H:%M') if patrol.completed_at else "—"
            
            # Подсчитываем данные
            checkpoints = len(patrol.checkpoints)
            photos = sum(len(cp.photos) for cp in patrol.checkpoints)
            
            # Длительность
            if patrol.completed_at:
                duration = patrol.completed_at - patrol.started_at
                hours, remainder = divmod(int(duration.total_seconds()), 3600)
                minutes, _ = divmod(remainder, 60)
                duration_str = f"{hours}ч {minutes}м"
            else:
                duration_str = "—"
            
            text += (
                f"🔹 <b>Обход #{patrol.id}</b>\n"
                f"  📅 {started} - {completed}\n"
                f"  ⏱ Длительность: {duration_str}\n"
                f"  📍 Точек: {checkpoints} | 📸 Фото: {photos}\n"
                f"  /patrol_details_{patrol.id}\n\n"
            )
        
        # Кнопки навигации
        buttons = []
        nav_buttons = []
        
        if page > 1:
            nav_buttons.append(InlineKeyboardButton(
                text="◀️ Назад", 
                callback_data=f"patrol_archive_page_{page - 1}"
            ))
        
        if page < total_pages:
            nav_buttons.append(InlineKeyboardButton(
                text="Вперёд ▶️", 
                callback_data=f"patrol_archive_page_{page + 1}"
            ))
        
        if nav_buttons:
            buttons.append(nav_buttons)
        
        buttons.append([InlineKeyboardButton(text="🏠 В меню обходов", callback_data="menu_patrol_management")])
        
        keyboard = InlineKeyboardMarkup(inline_keyboard=buttons)
        
        await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")
        await callback.answer()


