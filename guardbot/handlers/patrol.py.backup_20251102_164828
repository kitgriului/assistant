@router.callback_query(F.data == "menu_patrol_management")
async def open_patrol_menu(callback: types.CallbackQuery, state: FSMContext):
    """Open patrol management entrypoint: suggest continue or start new."""
    telegram_id = callback.from_user.id
    has_access, user = await check_user_access(telegram_id, [Role.GUARD.value, Role.ADMIN.value])
    if not has_access:
        await callback.answer("❌ Нет прав", show_alert=True)
        return

    # Check active patrol
    async with get_session() as session:
        result = await session.execute(
            select(PatrolEvent)
            .options(selectinload(PatrolEvent.checkpoints))
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'in_progress'
            )
        )
        active_patrol = result.scalar_one_or_none()

    # Адаптивное меню в зависимости от наличия активного обхода
    buttons = []
    
    if active_patrol:
        checkpoints_count = len(active_patrol.checkpoints)
        started_at = active_patrol.started_at
        text = (
            "🛡️ <b>Управление обходами</b>\n\n"
            "✅ Есть активный обход\n"
            f"📅 Начат: {started_at.strftime('%d.%m.%Y %H:%M')}\n"
            f"📍 Точек: {checkpoints_count}\n\n"
            "Выберите действие:"
        )
        
        buttons = [
            [InlineKeyboardButton(text="▶️ Продолжить обход", callback_data="patrol_continue")],
            [InlineKeyboardButton(text="📊 Статистика", callback_data="patrol_stats")],
            [InlineKeyboardButton(text="✅ Завершить обход", callback_data="patrol_finish")],
        ]
    else:
        text = (
            "🛡️ <b>Управление обходами</b>\n\n"
            "Нет активного обхода.\n\n"
            "Начните новый обход или посмотрите архив завершённых."
        )
        
        buttons = [
            [InlineKeyboardButton(text="🚶 Начать новый обход", callback_data="menu_start_patrol")],
        ]
    
    # Общие кнопки (доступны всегда)
    buttons.extend([
        [InlineKeyboardButton(text="� Архив обходов", callback_data="patrol_archive")],
        [InlineKeyboardButton(text="↩️ В главное меню", callback_data="main_menu")],
    ])
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=buttons)

    await callback.message.edit_text(
        text,
        reply_markup=keyboard,
        parse_mode="HTML",
    )
    await callback.answer()


@router.message(Command("patrols"))
async def patrols_command(message: types.Message, state: FSMContext):
    """Direct command to open patrol management submenu for non-guest roles."""
    await open_patrol_menu(type("Obj", (), {"from_user": message.from_user, "message": message})(), state)  # reuse callback flow


@router.callback_query(F.data == "menu_start_patrol")
async def start_new_patrol(callback: types.CallbackQuery, state: FSMContext):
    """Начать новый обход"""
    telegram_id = callback.from_user.id
    
    # Проверяем права доступа
    has_access, user = await check_user_access(telegram_id, [Role.GUARD.value, Role.ADMIN.value])
    
    if not has_access:
        await callback.answer("❌ Доступ запрещен", show_alert=True)
        return
    
    # Проверяем, нет ли уже активного обхода
    async with get_session() as session:
        result = await session.execute(
            select(PatrolEvent)
            .options(selectinload(PatrolEvent.checkpoints))
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'in_progress'
            )
        )
        active_patrol = result.scalar_one_or_none()
        
        if active_patrol:
            # Предложим продолжить существующий
            checkpoints_count = len(active_patrol.checkpoints)
            started_at = active_patrol.started_at
            
            keyboard = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="▶️ Продолжить текущий обход", callback_data="patrol_continue")],
                [InlineKeyboardButton(text="❌ Завершить текущий и начать новый", callback_data="patrol_finish_and_new")],
                [InlineKeyboardButton(text="◀️ Назад", callback_data="main_menu")]
            ])
            
            await callback.message.edit_text(
                "⚠️ <b>У вас уже есть активный обход</b>\n\n"
                f"Начат: {started_at.strftime('%d.%m.%Y %H:%M')}\n"
                f"Точек пройдено: {checkpoints_count}\n\n"
                "Выберите действие:",
                reply_markup=keyboard,
                parse_mode="HTML"
            )
            await callback.answer()
            return
        
        # Создаем новое событие обхода
        new_patrol = PatrolEvent(
            guard_id=user.id,
            status='in_progress',
            started_at=datetime.datetime.utcnow()
        )
        session.add(new_patrol)
        await session.commit()
        await session.refresh(new_patrol)
        
        # Сохраняем ID обхода в состоянии
        await state.update_data(patrol_event_id=new_patrol.id, checkpoint_number=1)
        await state.set_state(PatrolStates.in_patrol)
    
    await callback.answer("✅ Обход начат!")
    await show_patrol_menu(callback.message, state)


