@router.callback_query(F.data == "patrol_finish_and_new")
async def finish_and_start_new(callback: types.CallbackQuery, state: FSMContext):
    """Завершить текущий обход и начать новый"""
    telegram_id = callback.from_user.id
    
    has_access, user = await check_user_access(telegram_id, [Role.GUARD.value, Role.ADMIN.value])
    
    if not has_access:
        await callback.answer("❌ Доступ запрещен", show_alert=True)
        return
    
    async with get_session() as session:
        # Завершаем текущий обход
        result = await session.execute(
            select(PatrolEvent)
            .where(
                PatrolEvent.guard_id == user.id,
                PatrolEvent.status == 'in_progress'
            )
        )
        active_patrol = result.scalar_one_or_none()
        
        if active_patrol:
            active_patrol.status = 'completed'
            active_patrol.completed_at = datetime.datetime.utcnow()
        
        # Создаем новый обход
        new_patrol = PatrolEvent(
            guard_id=user.id,
            status='in_progress',
            started_at=datetime.datetime.utcnow()
        )
        session.add(new_patrol)
        await session.commit()
        await session.refresh(new_patrol)
        
        await state.update_data(patrol_event_id=new_patrol.id, checkpoint_number=1)
        await state.set_state(PatrolStates.in_patrol)
    
    await callback.answer("✅ Новый обход начат!")
    await show_patrol_menu(callback.message, state)


async def show_patrol_menu(message_or_callback, state: FSMContext):
    """
    Показать меню обхода с кнопками действий
    
    Args:
        message_or_callback: Может быть Message или CallbackQuery
        state: FSM context
    """
    data = await state.get_data()
    checkpoint_number = data.get('checkpoint_number', 1)
    patrol_event_id = data.get('patrol_event_id')
    
    # Получаем информацию об обходе с eager loading checkpoints
    async with get_session() as session:
        result = await session.execute(
            select(PatrolEvent)
            .options(selectinload(PatrolEvent.checkpoints))
            .where(PatrolEvent.id == patrol_event_id)
        )
        patrol = result.scalar_one_or_none()
        
        if not patrol:
            if isinstance(message_or_callback, types.CallbackQuery):
                await message_or_callback.answer("❌ Обход не найден", show_alert=True)
            else:
                await message_or_callback.answer("❌ Обход не найден")
            return
        
        total_checkpoints = len(patrol.checkpoints)
        started_at = patrol.started_at
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="➕ Добавить точку обхода", callback_data="patrol_add_checkpoint")],
        [
            InlineKeyboardButton(text="📊 Статистика", callback_data="patrol_stats"),
            InlineKeyboardButton(text="🔄 Обновить", callback_data="patrol_refresh_menu")
        ],
        [InlineKeyboardButton(text="✅ Завершить обход", callback_data="patrol_finish")],
        [InlineKeyboardButton(text="◀️ Вернуться в меню", callback_data="patrol_cancel")]
    ])
    
    text = (
        f"🚶 <b>Обход в процессе</b>\n\n"
        f"📅 Начат: {started_at.strftime('%d.%m.%Y %H:%M')}\n"
        f"✅ Точек пройдено: {total_checkpoints}\n"
        f"➡️ Следующая точка: №{checkpoint_number}\n\n"
        f"Выберите действие:\n\n"
        f"💡 <i>Совет: используйте /patrol_menu для быстрого возврата в это меню</i>"
    )
    
    # Универсальная отправка сообщения
    if isinstance(message_or_callback, types.CallbackQuery):
        # Если это callback - пытаемся отредактировать, если не получается - отправляем новое
        try:
            await message_or_callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")
        except Exception as e:
            # Telegram не позволяет редактировать, отправляем новое сообщение
            await message_or_callback.message.answer(text, reply_markup=keyboard, parse_mode="HTML")
    else:
        # Если это обычное сообщение - просто отправляем
        await message_or_callback.answer(text, reply_markup=keyboard, parse_mode="HTML")


@router.callback_query(F.data == "patrol_add_checkpoint")
async def add_checkpoint(callback: types.CallbackQuery, state: FSMContext):
    """Начать добавление точки обхода"""
    data = await state.get_data()
    checkpoint_number = data.get('checkpoint_number', 1)
    patrol_event_id = data.get('patrol_event_id')
    
    # Создаем новую точку обхода в БД
    async with get_session() as session:
        new_checkpoint = PatrolCheckpoint(
            event_id=patrol_event_id,
            checkpoint_number=checkpoint_number,
            timestamp=datetime.datetime.utcnow()
        )
        session.add(new_checkpoint)
        await session.commit()
        await session.refresh(new_checkpoint)
        
        # Сохраняем ID точки в состоянии с инициализацией всех флагов
        await state.update_data(
            current_checkpoint_id=new_checkpoint.id,
            checkpoint_photos_count=0,
            checkpoint_has_location=False,
            checkpoint_has_note=False
        )
    
    await state.set_state(PatrolStates.waiting_checkpoint_action)
    await callback.answer()
    await show_checkpoint_menu(callback.message, state)


