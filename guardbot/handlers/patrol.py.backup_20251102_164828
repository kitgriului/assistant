@router.message(PatrolStates.waiting_notes, F.text)
async def handle_note(message: types.Message, state: FSMContext):
    """Обработать заметку"""
    data = await state.get_data()
    current_checkpoint_id = data.get('current_checkpoint_id')
    
    if not current_checkpoint_id:
        await message.answer("❌ Ошибка: точка обхода не найдена")
        return
    
    # Сохраняем заметку
    async with get_session() as session:
        result = await session.execute(
            select(PatrolCheckpoint)
            .where(PatrolCheckpoint.id == current_checkpoint_id)
        )
        checkpoint = result.scalar_one_or_none()
        
        if checkpoint:
            checkpoint.notes = message.text
            await session.commit()
    
    # Обновляем флаг наличия заметки
    await state.update_data(checkpoint_has_note=True)
    await state.set_state(PatrolStates.waiting_checkpoint_action)
    
    await message.answer("✅ Заметка добавлена!")
    await show_checkpoint_menu(message, state)


