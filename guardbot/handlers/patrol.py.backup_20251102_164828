@router.message(PatrolStates.waiting_location, F.location)
async def handle_location(message: types.Message, state: FSMContext):
    """Обработать полученную геолокацию"""
    data = await state.get_data()
    current_checkpoint_id = data.get('current_checkpoint_id')
    
    if not current_checkpoint_id:
        await message.answer("❌ Ошибка: точка обхода не найдена")
        return
    
    # Сохраняем координаты
    async with get_session() as session:
        result = await session.execute(
            select(PatrolCheckpoint)
            .where(PatrolCheckpoint.id == current_checkpoint_id)
        )
        checkpoint = result.scalar_one_or_none()
        
        if checkpoint:
            checkpoint.latitude = message.location.latitude
            checkpoint.longitude = message.location.longitude
            await session.commit()
    
    await state.update_data(checkpoint_has_location=True)
    await state.set_state(PatrolStates.waiting_checkpoint_action)
    
    await message.answer(
        f"✅ Геолокация добавлена!\n"
        f"📍 {message.location.latitude:.6f}, {message.location.longitude:.6f}",
        reply_markup=ReplyKeyboardRemove()
    )
