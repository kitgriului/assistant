@router.message(Command("patrol_menu"))
async def patrol_menu_command(message: types.Message, state: FSMContext):
    """Быстрый доступ к меню активного обхода"""
    telegram_id = message.from_user.id
    
    has_access, user = await check_user_access(telegram_id, [Role.GUARD.value, Role.ADMIN.value])
    
    if not has_access:
        await message.answer("❌ Доступ запрещен")
        return
    
    # Проверяем есть ли активный обход
    data = await state.get_data()
    patrol_event_id = data.get('patrol_event_id')
    
    if not patrol_event_id:
        # Ищем в БД
        async with get_session() as session:
            result = await session.execute(
                select(PatrolEvent)
                .where(
                    PatrolEvent.guard_id == user.id,
                    PatrolEvent.status == 'in_progress'
                )
            )
            active_patrol = result.scalar_one_or_none()
            
            if active_patrol:
                # Восстанавливаем состояние
                checkpoint_count = len(active_patrol.checkpoints)
                await state.update_data(
                    patrol_event_id=active_patrol.id,
                    checkpoint_number=checkpoint_count + 1
                )
                await state.set_state(PatrolStates.in_patrol)
            else:
                await message.answer(
                    "❌ У вас нет активного обхода.\n\n"
                    "Используйте /start для входа в главное меню."
                )
                return
    
