# ===============================================
# GuardBot PRODUCTION Environment Configuration
# ===============================================
# SECURITY WARNING: Keep this file secure!
# Never commit this file to version control!
# ===============================================

# -----------------------------------------------
# REQUIRED: Telegram Bot Configuration
# -----------------------------------------------
BOT_TOKEN=YOUR_PRODUCTION_BOT_TOKEN_HERE

# -----------------------------------------------
# Environment Settings
# -----------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------
# Database Configuration
# -----------------------------------------------
# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///guardbot.db

# Optional: PostgreSQL for production (recommended for high load)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/guardbot

# -----------------------------------------------
# Logging Configuration
# -----------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging (creates logs/ directory)
LOG_TO_FILE=true

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# -----------------------------------------------
# Security Settings
# -----------------------------------------------
# Rate limiting (requests per second per user)
RATE_LIMIT_RPS=5

# Callback deduplication timeout (seconds)
CALLBACK_DEDUP_TTL=3

# User action lock timeout (seconds)
ACTION_LOCK_TIMEOUT=10

# -----------------------------------------------
# Media Settings
# -----------------------------------------------
# Maximum photo size (bytes) - 10MB default
MAX_PHOTO_SIZE=10485760

# Maximum photos per checkpoint
MAX_PHOTOS_PER_CHECKPOINT=10

# Media storage path
MEDIA_PATH=data/media

# -----------------------------------------------
# Patrol Settings
# -----------------------------------------------
# Auto-close patrols older than (hours)
PATROL_AUTO_CLOSE_HOURS=24

# -----------------------------------------------
# Telegram Bot Settings
# -----------------------------------------------
# Webhook mode (for production with reverse proxy)
# Leave empty for polling mode
WEBHOOK_URL=

# Webhook secret token (for security)
WEBHOOK_SECRET=

# Webhook path
WEBHOOK_PATH=/webhook

# -----------------------------------------------
# Monitoring & Health Checks
# -----------------------------------------------
# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check port
HEALTH_CHECK_PORT=8080

# -----------------------------------------------
# Backup Settings
# -----------------------------------------------
# Enable automatic database backups
ENABLE_AUTO_BACKUP=true

# Backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# Backup retention (days)
BACKUP_RETENTION_DAYS=7

# Backup path
BACKUP_PATH=backups
