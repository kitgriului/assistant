[Unit]
Description=Whisper Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/assistant/whisper-bot
Environment="PATH=/root/assistant/whisper-bot/venv/bin"
ExecStart=/root/assistant/whisper-bot/venv/bin/python src/main.py
Restart=always
RestartSec=10

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whisper-bot

[Install]
WantedBy=multi-user.target
